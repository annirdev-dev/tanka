{
  "expo": {
    "name": "Tanka",
    "slug": "tanka",
    "version": "1.0.0",
    "scheme": "tanka",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tanka.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Tanka uses your location to find nearby fuel stations and compare prices.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tanka.app",
      "adaptiveIcon": {
        "backgroundColor": "#1A8A60",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyB9IgALWl23qd8eN3F8Bswz3o3kzeSEghg"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tanka uses your location to find nearby fuel stations and compare prices.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-font",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.598383804471-30clmudvk67iplga0le45rnb0k5lfdc4"
        }
      ],
      "expo-iap"
    ],
    "owner": "aniro99",
    "extra": {
      "eas": {
        "projectId": "da8d3201-46a7-4518-a374-25712a27f6fd"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/da8d3201-46a7-4518-a374-25712a27f6fd"
    }
  }
}
