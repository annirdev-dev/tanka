# Supabase project — used for account sign-in, cross-device sync of
# favorites/alerts, AND as the entire backend API (see supabase/functions/):
# nearby-station search, price history, and driving routes all run as Edge
# Functions against this same project, so no separate server URL is needed.
# Find these in Supabase Dashboard > Project Settings > API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Google Sign-In (native, via @react-native-google-signin/google-signin).
# Needs THREE separate Google Cloud OAuth clients (same project):
# - "iOS" type (bundle ID com.tanka.app): its Client ID goes here as
#   EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID, and its *reversed* form goes into
#   app.json's @react-native-google-signin/google-signin plugin config
#   (iosUrlScheme), e.g. com.googleusercontent.apps.XXXXXXXXXX
# - "Web application" type (no redirect URIs needed): its Client ID goes here
#   as EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID, and must also be set as the Google
#   provider's Client ID in Supabase Dashboard > Authentication > Providers > Google.
# - "Android" type (package name com.tanka.app): its Client ID is never used
#   in code, but Play Services checks that this client exists for the calling
#   app's package + signing certificate SHA-1 before allowing sign-in at all.
#   Missing this (or registering the wrong SHA-1) is THE most common cause of
#   "DEVELOPER_ERROR" on Android, even when the Web/iOS client IDs above are
#   correct. Get the SHA-1 of your EAS build's signing credentials with
#   `npx eas credentials` (Android > select your build profile > view
#   credentials), and add it under this Android OAuth client in Google Cloud
#   Console > APIs & Services > Credentials. A new dev-client build isn't
#   needed after registering it — it's checked at sign-in time, not baked
#   into the binary.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Optional: set to 1 to show the Settings "Testing" section (fake location,
# end/restart trial, manual update check). The `testflight` EAS build profile
# sets it; the `production` profile (App Store) must NEVER set it.
# EXPO_PUBLIC_TEST_TOOLS=1
