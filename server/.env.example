API_ABERTA_KEY=your-api-key-here
PORT=3000

# Background price-alert push job (server/src/pushAlerts.ts). Service role
# key, NOT the anon/publishable key the app uses — find both in Supabase
# Dashboard > Project Settings > API Keys. Keep this secret; it bypasses row-level security.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Driving-route lookups for "On My Way" (server/src/routing.ts). Uses Google's
# Routes API — enable "Routes API" on the Google Cloud project and create a
# key restricted to it in APIs & Services > Credentials. Stays within the free
# tier (10,000 requests/month) as long as routingPreference stays TRAFFIC_UNAWARE.
GOOGLE_ROUTES_API_KEY=your-google-routes-api-key
