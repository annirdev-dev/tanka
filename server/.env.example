API_ABERTA_KEY=your-api-key-here
PORT=3000

# Background price-alert push job (server/src/pushAlerts.ts). Service role
# key, NOT the anon/publishable key the app uses — find both in Supabase
# Dashboard > Project Settings > API Keys. Keep this secret; it bypasses row-level security.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Driving-route lookups for "On My Way" (server/src/routing.ts). Free tier at
# openrouteservice.org — sign up, generate a key from the dashboard.
ORS_API_KEY=your-openrouteservice-api-key
